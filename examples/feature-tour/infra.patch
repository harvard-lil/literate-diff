diff --git a/ecr.tf b/ecr.tf
index 3c9c4fe..a4d723f 100644
--- a/ecr.tf
+++ b/ecr.tf
@@ -1,16 +1,30 @@
 resource "aws_ecr_repository" "wren" {
-  name                 = "wren"
-  image_tag_mutability = "MUTABLE"
+  name = "wren"
+  # SHA tags name a tested build and must not move; `latest` stays a pointer.
+  image_tag_mutability = "IMMUTABLE_WITH_EXCLUSION"
+  image_tag_mutability_exclusion_filter {
+    filter      = "latest"
+    filter_type = "WILDCARD"
+  }
 }
 
+# Two populations age at different rates: deployed images and candidates.
 resource "aws_ecr_lifecycle_policy" "wren" {
   repository = aws_ecr_repository.wren.name
   policy = jsonencode({
-    rules = [{
-      rulePriority = 1
-      description  = "keep last 5 images"
-      selection    = { tagStatus = "any", countType = "imageCountMoreThan", countNumber = 5 }
-      action       = { type = "expire" }
-    }]
+    rules = [
+      {
+        rulePriority = 1
+        description  = "Keep the last 20 deployed images, for rollback"
+        selection    = { tagStatus = "tagged", tagPrefixList = ["deployed-"], countType = "imageCountMoreThan", countNumber = 20 }
+        action       = { type = "expire" }
+      },
+      {
+        rulePriority = 2
+        description  = "Keep the last 20 build candidates"
+        selection    = { tagStatus = "any", countType = "imageCountMoreThan", countNumber = 20 }
+        action       = { type = "expire" }
+      },
+    ]
   })
 }
diff --git a/iam.tf b/iam.tf
index 0cebbe5..79502d8 100644
--- a/iam.tf
+++ b/iam.tf
@@ -6,7 +6,8 @@ resource "aws_iam_role" "deploy" {
       Principal = { Federated = var.github_oidc_provider_arn }
       Action    = "sts:AssumeRoleWithWebIdentity"
       Condition = {
-        StringLike = { "token.actions.githubusercontent.com:sub" = "repo:example/wren:*" }
+        # The prod environment only. `repo:example/wren:*` let any branch in.
+        StringEquals = { "token.actions.githubusercontent.com:sub" = "repo:example/wren:environment:prod" }
       }
     }]
   })
