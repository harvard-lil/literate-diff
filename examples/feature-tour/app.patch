diff --git a/Dockerfile b/Dockerfile
index 0883488..71f6ff2 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,7 +1,19 @@
-FROM python:3.12-slim
+# base: dependencies only. Shared by every stage below.
+FROM python:3.12-slim AS base
 WORKDIR /app
 COPY requirements.txt .
-RUN pip install -r requirements.txt
+RUN pip install --no-cache-dir -r requirements.txt
+
+# prod: the artifact that ships. Settings are chosen at runtime.
+FROM base AS prod
 COPY app/ ./app
-RUN cp app/settings_prod.py app/settings.py
+ENV WREN_SETTINGS_MODULE=settings_prod
 CMD ["gunicorn", "app.wsgi"]
+
+# test: prod plus the test toolchain, so CI tests the bytes that ship.
+FROM prod AS test
+RUN pip install --no-cache-dir pytest
+
+# dev: base plus the toolchain, with the working tree mounted over it.
+FROM base AS dev
+RUN pip install --no-cache-dir pytest
